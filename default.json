{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":prConcurrentLimitNone",
    ":prHourlyLimitNone"
  ],
  "commitBody": "Co-authored-by: Neluxx <fabian.arndt96@proton.me>",
  "assignees": ["neluxx"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "description": "Major updates only on the dashboard, no PR",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Automerge everything else once CI is green",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    }
  ],
  "lockFileMaintenance": { "automerge": true },
  "vulnerabilityAlerts": { "addLabels": ["security"] },
  "osvVulnerabilityAlerts": true
}
