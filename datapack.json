{
  "extends": ["github>Neluxx/.github"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    },
    {
      "description": "Keep Python below 3.15",
      "matchPackageNames": ["/(^|/)python$/"],
      "allowedVersions": "<3.15"
    }
  ],
  "lockFileMaintenance": { "enabled": true, "automerge": true }
}
