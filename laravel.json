{
  "extends": ["github>Neluxx/.github"],
  "packageRules": [
    {
      "description": "Automerge dev dependencies",
      "matchDepTypes": ["require-dev", "devDependencies"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "dev dependencies",
      "automerge": true
    },
    {
      "description": "Automerge runtime dependencies",
      "matchDepTypes": ["require", "dependencies"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "runtime dependencies",
      "automerge": true
    }
  ],
  "lockFileMaintenance": { "enabled": true, "automerge": true }
}
